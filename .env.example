# ─────────────────────────────────────────────────────────────────────────────
# REUNITE — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────────────────────

# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-production-secret-key-here

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts in production
# e.g. DJANGO_ALLOWED_HOSTS=reunite.yourcollege.edu,www.reunite.yourcollege.edu
DJANGO_ALLOWED_HOSTS=

# Comma-separated list of allowed frontend origins (for CORS in production)
# e.g. CORS_ALLOWED_ORIGINS=https://reunite.yourcollege.edu
# In DEBUG=True mode, all origins are allowed automatically.
CORS_ALLOWED_ORIGINS=

# ── AI Integration (Gemini Primary, OpenAI Fallback) ───────────────────────────
# Primary: Google Gemini Vision API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback: OpenAI Vision API (https://platform.openai.com/api-keys)
# Automatically called if Gemini hits quota (HTTP 429), errors, or is unconfigured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# ── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (development only).
# In production PostgreSQL, you can supply either DATABASE_URL or individual DB_* variables:
# DATABASE_URL=postgres://reunite_user:secure-db-password@localhost:5432/reunite_db
# OR:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=reunite_db
# DB_USER=reunite_user
# DB_PASSWORD=secure-db-password
# DB_HOST=localhost
# DB_PORT=5432

# ── Media & File Storage (Cloudinary) ────────────────────────────────────────
# Cloudinary credentials (REQUIRED in staging/production for persistent photo uploads):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# For offline local development only (uses container/local filesystem):
# USE_LOCAL_STORAGE=True
# MEDIA_ROOT=/path/to/media
# MEDIA_URL=/media/

# ── Redis / Celery ───────────────────────────────────────────────────────────
# Required only if using background tasks (Celery).
# REDIS_URL=redis://localhost:6379/0

# ── Email ────────────────────────────────────────────────────────────────────
# Default: console backend (prints emails to terminal — development only)
# For production, configure SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
