# ─────────────────────────────────────────────────────────────────────────────
# REUNITE — Production Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env on the production server host.
# Fill in your institutional credentials and domain settings.
# NEVER commit the real .env file or production secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core Settings ─────────────────────────────────────────────────────

# REQUIRED: Cryptographically secure random secret key (minimum 50 characters).
# Generate on host with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# REQUIRED: Production must run with DEBUG disabled.
DJANGO_DEBUG=False

# REQUIRED: Comma-separated list of fully qualified domain names and hostnames.
# Example: reunite.campus.edu,api.reunite.campus.edu
DJANGO_ALLOWED_HOSTS=

# Comma-separated list of allowed frontend origins for CORS.
# Required only if the frontend is hosted on a different domain/port from the API.
# Example: https://reunite.campus.edu
CORS_ALLOWED_ORIGINS=

# Comma-separated list of trusted origins for CSRF protection.
# Example: https://reunite.campus.edu,https://api.reunite.campus.edu
CSRF_TRUSTED_ORIGINS=

# ── Production Database (PostgreSQL) ──────────────────────────────────────────
# PostgreSQL is strongly recommended for campus pilot and production deployments.
# Provide either a standard connection URI:
DATABASE_URL=postgres://reunite_user:YOUR_DB_PASSWORD@localhost:5432/reunite_db

# OR configure individual DB_* parameters:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=reunite_db
# DB_USER=reunite_user
# DB_PASSWORD=YOUR_DB_PASSWORD
# DB_HOST=localhost
# DB_PORT=5432

# ── Persistent Storage & Static Assets ────────────────────────────────────────
# REQUIRED: Filesystem path to mounted persistent disk storage for item photographs.
# Must NOT be an ephemeral or container-local path.
MEDIA_ROOT=/var/reunite/media
MEDIA_URL=/media/

# Directory where Django static assets will be gathered by collectstatic.
STATIC_ROOT=/var/reunite/backend/staticfiles

# ── AI Vision Integration (Gemini Primary, OpenAI Fallback) ───────────────────
# Primary: Google Gemini Vision (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fallback: OpenAI Vision (https://platform.openai.com/api-keys)
# Engaged automatically if Gemini reaches quota (HTTP 429) or is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Email Notifications (SMTP) ───────────────────────────────────────────────
# Configure SMTP credentials if email notifications are enabled.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=lostfound@college.edu
# EMAIL_HOST_PASSWORD=YOUR_SMTP_APP_PASSWORD
# DEFAULT_FROM_EMAIL="Reunite Lost & Found <lostfound@college.edu>"

# ── Frontend API Base URL ────────────────────────────────────────────────────
# For reverse proxy / same-origin deployments (recommended), leave this blank.
# If frontend is hosted independently from the backend API, specify the backend URL:
# Example: https://api.reunite.campus.edu
VITE_API_URL=

