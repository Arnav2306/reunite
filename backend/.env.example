# ─────────────────────────────────────────────────────────────────────────────
# REUNITE — Backend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env in your root directory and fill in your values.
# NEVER commit .env with real credentials to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────────────────────

# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-production-secret-key-here

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts in production
# e.g. DJANGO_ALLOWED_HOSTS=reunite.yourcollege.edu,www.reunite.yourcollege.edu
DJANGO_ALLOWED_HOSTS=

# Comma-separated list of allowed frontend origins (for CORS in production)
# e.g. CORS_ALLOWED_ORIGINS=https://reunite.yourcollege.edu
# In DEBUG=True mode, all origins are allowed automatically.
CORS_ALLOWED_ORIGINS=

# ── AI Integration ───────────────────────────────────────────────────────────
# At least one AI key should be set to enable AI image analysis.
# If neither key is provided, the system degrades gracefully — items can still
# be submitted and reviewed manually without AI assistance.

# Google Gemini API key (recommended — used for image analysis)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API key (optional — reserved for future OpenAI integration)
OPENAI_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (development only).
# In production PostgreSQL, you can supply either DATABASE_URL or individual DB_* variables:
# DATABASE_URL=postgres://reunite_user:secure-db-password@localhost:5432/reunite_db
# OR:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=reunite_db
# DB_USER=reunite_user
# DB_PASSWORD=secure-db-password
# DB_HOST=localhost
# DB_PORT=5432

# ── Media & File Storage ─────────────────────────────────────────────────────
# For production deployments with persistent storage mount:
# MEDIA_ROOT=/path/to/persistent/media
# MEDIA_URL=/media/

# ── Redis / Celery ───────────────────────────────────────────────────────────
# Required only if using background tasks (Celery).
# REDIS_URL=redis://localhost:6379/0

# ── Email ────────────────────────────────────────────────────────────────────
# Default: console backend (prints emails to terminal — development only)
# For production, configure SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
