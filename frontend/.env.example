# ─────────────────────────────────────────────────────────────────────────────
# REUNITE — Frontend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# For same-origin / reverse proxy deployments (e.g. Nginx, Caddy, single-domain):
# Leave VITE_API_URL empty. Relative paths (/api/...) will be used automatically.
#
# For separate frontend / backend hosting:
# (e.g. Frontend on reunite.college.edu, Backend on api.reunite.college.edu)
# Set VITE_API_URL to the backend domain without trailing slash:
# VITE_API_URL=https://api.reunite.college.edu
VITE_API_URL=
